# Скопируйте в .env и заполните. Файл .env в .gitignore — не коммитьте его.

# YouTube Data API v3 (не обязателен: без него используется yt-dlp).
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# TikTok for Developers -> ваше приложение -> Content Posting API.
# https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Получаются один раз:
#   yt2tt auth url --redirect-uri https://example.com/callback
#   yt2tt auth exchange --code <code> --redirect-uri https://example.com/callback
TIKTOK_REFRESH_TOKEN=
TIKTOK_ACCESS_TOKEN=
